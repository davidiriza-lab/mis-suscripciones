{
  "name": "mis-suscripciones",
  "displayName": "Mis suscripciones",
  "description": "Cuánto te queda de Claude, ChatGPT y Gemini, y tus chats de Claude Code en vivo.",
  "version": "0.1.0",
  "publisher": "davidiriza-lab",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "repository": { "type": "git", "url": "https://github.com/davidiriza-lab/mis-suscripciones.git" },
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "suscripciones", "title": "Mis suscripciones", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "suscripciones": [
        { "id": "suscripciones.vista", "type": "webview", "name": "Cuota y guía" }
      ]
    },
    "commands": [
      { "command": "suscripciones.actualizar", "title": "Mis suscripciones: Actualizar cuotas", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        { "command": "suscripciones.actualizar", "when": "view == suscripciones.vista", "group": "navigation" }
      ]
    }
  }
}
