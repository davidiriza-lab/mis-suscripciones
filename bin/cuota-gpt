#!/usr/bin/env python3
"""Muestra cuánto te queda de GPT en Codex (suscripción ChatGPT), en español y con tu hora local.

Uso: cuota-gpt [--json]
Le pregunta en vivo al servidor local de Codex (account/rateLimits/read).
"""
from __future__ import annotations

import json
import select
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

CODEX = str(Path(__file__).resolve().parent / "codex-sub")
DIAS = ["lun", "mar", "mié", "jue", "vie", "sáb", "dom"]


def cuando(ts: float) -> str:
    t = datetime.fromtimestamp(ts).astimezone()
    hoy = datetime.now().astimezone().date()
    if t.date() == hoy:
        dia = "hoy"
    elif (t.date() - hoy).days == 1:
        dia = "mañana"
    else:
        dia = f"{DIAS[t.weekday()]} {t.day}"
    return f"{dia} {t.strftime('%H:%M')}"


def barra(pct: int) -> str:
    llenos = round(pct / 10)
    return "█" * llenos + "░" * (10 - llenos)


def semaforo(pct: int) -> str:
    return "bien" if pct >= 50 else "cuidado" if pct >= 20 else "casi vacío"


def leer_cuota() -> dict:
    p = subprocess.Popen([CODEX, "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True)
    try:
        def send(o: dict) -> None:
            p.stdin.write(json.dumps(o) + "\n")
            p.stdin.flush()

        send({"id": 1, "method": "initialize", "params": {"clientInfo": {"name": "cuota-gpt", "version": "1"}}})
        send({"method": "initialized"})
        send({"id": 2, "method": "account/rateLimits/read"})
        fin = time.time() + 30
        while time.time() < fin:
            listo, _, _ = select.select([p.stdout], [], [], 1)
            if not listo:
                continue
            linea = p.stdout.readline()
            if not linea:
                break
            try:
                o = json.loads(linea)
            except json.JSONDecodeError:
                continue
            if o.get("id") == 2:
                if "error" in o:
                    raise RuntimeError(o["error"].get("message", str(o["error"])))
                return o["result"]
        raise RuntimeError("Codex no contestó a tiempo")
    finally:
        p.kill()


def main() -> int:
    try:
        r = leer_cuota()
    except (OSError, RuntimeError) as e:
        if "--json" in sys.argv:
            print(json.dumps({"ok": False, "ventanas": [], "error": f"No pude leer la cuota de Codex: {e}"}))
            return 1
        print(f"No pude leer la cuota de Codex: {e}")
        print("Si es la sesión: entra a Codex con tu cuenta de ChatGPT (`codex-sub login`).")
        return 1

    rl = r.get("rateLimits") or {}
    if "--json" in sys.argv:  # para paneles y scripts: mismo dato, sin dibujo
        ventanas = []
        for clave, etiqueta in (("primary", "cada 5 horas"), ("secondary", "semanal")):
            v = rl.get(clave)
            if v:
                ventanas.append({"grupo": "GPT en Codex", "etiqueta": etiqueta,
                                 "queda": max(0, 100 - int(round(v.get("usedPercent", 0)))),
                                 "recarga": datetime.fromtimestamp(v["resetsAt"]).astimezone().isoformat()})
        libres = [c for c in (r.get("rateLimitResetCredits") or {}).get("credits", []) if c.get("status") == "available"]
        print(json.dumps({"ok": True, "plan": rl.get("planType"), "ventanas": ventanas, "reinicios": len(libres),
                          "reinicioVence": datetime.fromtimestamp(min(c["expiresAt"] for c in libres)).astimezone().isoformat() if libres else None,
                          "error": None}))
        return 0
    plan = (rl.get("planType") or "?").capitalize()
    print(f"Lo que te queda de tu suscripción ChatGPT (plan {plan})\n")
    print("GPT en Codex")
    for clave, etiqueta in (("primary", "cada 5 horas"), ("secondary", "semanal")):
        v = rl.get(clave)
        if not v:
            continue
        queda = max(0, 100 - int(round(v.get("usedPercent", 0))))
        print(f"  {etiqueta:<13} {barra(queda)} {queda:>3}%  {semaforo(queda):<10} se recarga {cuando(v['resetsAt'])}")

    resets = [c for c in (r.get("rateLimitResetCredits") or {}).get("credits", []) if c.get("status") == "available"]
    if resets:
        vence = min(c["expiresAt"] for c in resets)
        print(f"\n  Reinicios gratis guardados: {len(resets)} (rellenan todo al 100%; el primero vence {cuando(vence)})")
        print("  Se usan desde Codex cuando te quedas sin cuota.")
    if rl.get("rateLimitReachedType"):
        print(f"\n  Ojo: llegaste al límite ({rl['rateLimitReachedType']}).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
